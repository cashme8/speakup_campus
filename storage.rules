rules_version = '2';

// SpeakUp Campus - Firebase Storage security rules.
// Photos live at incident_photos/{uid}/{incidentId}.jpg
service firebase.storage {
  match /b/{bucket}/o {

    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
             .matches('^[^@]+@(alustudent|alueducation)[.]com$');
    }

    match /incident_photos/{uid}/{fileName} {
      allow read: if verified();

      // Only into your own folder, images only, max 5 MB.
      allow create, update: if verified()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if verified() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
